NODE_ENV=development
# Overrides api.port from erxes.json.
# PORT=
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Required by the platform stack (tenant-scoped Mongoose models).
# MONGO_URL=mongodb://localhost:27017/erxes
# Where the browser loads the UI remote from. Unset = plugins.erxes.io/<release>/eduflow_ui/.
UI_ENTRY_URL=http://localhost:3099/remoteEntry.js
# Address the gateway uses to reach this API. Unset = localhost (dev) or plugin-eduflow-api (prod).
# LOAD_BALANCER_ADDRESS=
# Release folder on plugins.erxes.io when it starts with "3."; otherwise "latest".
# RELEASE_VERSION=

# --- AI homework checking (Google AI Studio) ---
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# --- Parent SMS (Twilio); unset = dummy mode ---
# SMS_PROVIDER=dummy
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
